{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Context Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "authorityDomains",
    "scopes",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": ["name", "root"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "const": "."
        }
      }
    },
    "authorityDomains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "sources"],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "agents", "skills"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "agents": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "path",
        "status",
        "authorityDomains",
        "owners",
        "appliesTo",
        "relationships",
        "implementationRefs",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "instruction",
            "skill",
            "adr",
            "ui",
            "requirement",
            "plan",
            "handoff",
            "validation",
            "runbook",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "authorityDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "target"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "implementationRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review": {
          "type": "object",
          "required": ["commit", "at", "by"],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": ["string", "null"]
            },
            "at": {
              "type": ["string", "null"]
            },
            "by": {
              "type": ["string", "null"]
            }
          }
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
