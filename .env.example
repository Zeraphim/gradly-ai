# Server only. Never prefix a credential with VITE_.
NEBIUS_API_KEY=
# Explicit preview mode works without a credential. It checks the choice only.
# Set false to assess the learner's reasoning using Nemotron on Nebius.
PREVIEW_MODE=true
# Explicit sample-flow opt-in; refused on Vercel or in production.
DEMO_MODE=true
PORT=3001
HOST=127.0.0.1

# Existing regional endpoint/model are the defaults; override only after checking access.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional research extension. Enabled locally; explicit opt-in is required on Vercel.
# The existing curated adventure works without this database configuration.
RESEARCH_ENABLED=true
DATABASE_URL=file:.data/gradly.db
DATABASE_AUTH_TOKEN=
SESSION_SECRET=
CRON_SECRET=
MAX_UPLOAD_BYTES=4000000
# Only needed if your frontend and API have distinct canonical origins.
APP_ORIGIN=
