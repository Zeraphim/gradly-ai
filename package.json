{
  "name": "paperquest",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preview": "npm run predev && node scripts/dev.mjs --preview",
    "dev:prototype": "npm run dev --workspace @paperquest/web",
    "build": "npm run build --workspace @paperquest/contracts && npm run build --workspace @paperquest/web && npm run build --workspace @paperquest/api",
    "start": "node --env-file-if-exists=.env apps/api/dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @paperquest/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:research && npm run build",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/verify-live.ts",
    "preeval:nemotron": "npm run build --workspace @paperquest/contracts",
    "eval:nemotron": "node --env-file-if-exists=.env --import tsx scripts/eval-nemotron.ts",
    "pregenerate:studies": "npm run build --workspace @paperquest/contracts",
    "generate:studies": "node --env-file-if-exists=.env --import tsx scripts/generate-prepared-studies.ts",
    "define:terms": "node --env-file-if-exists=.env --import tsx scripts/define-prepared-terms.ts",
    "test:issue5": "node --import tsx scripts/verify-issue-5.ts",
    "test:issue6": "node --import tsx scripts/verify-issue-6.ts",
    "test:flow": "node --env-file-if-exists=.env --import tsx scripts/run-live-flow.ts",
    "build:vercel": "npm run build --workspace @paperquest/contracts && npm run build --workspace @paperquest/web && node scripts/prepare-vercel.mjs",
    "predev": "npm run build --workspace @paperquest/contracts",
    "pretest": "npm run build --workspace @paperquest/contracts",
    "test:research": "vitest run",
    "test:e2e": "playwright test",
    "vercel-build": "npm run build:vercel",
    "context:check": "node .agents/scripts/context-audit.mjs check",
    "context:index": "node .agents/scripts/context-audit.mjs index",
    "context:acknowledge": "node .agents/scripts/context-audit.mjs acknowledge",
    "diagnose:nebius": "node --env-file-if-exists=.env --import tsx scripts/diagnose-nebius.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.5",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "express": "5.3.0"
  }
}
