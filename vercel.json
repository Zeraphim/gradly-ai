{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    },
    {
      "src": "server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/{tesseract.js,tesseract.js-core,@tesseract.js-data/eng,@napi-rs/canvas,@napi-rs/canvas-*}/**/*",
          "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
        ]
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.ts"
    }
  ]
}
